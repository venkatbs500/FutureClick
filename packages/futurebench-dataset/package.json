{
  "name": "@futureclick/futurebench-dataset",
  "version": "0.1.0",
  "private": true,
  "description": "Offline synthetic FutureBench dataset foundation for FC-008: scenarios, specificity oracle, records, partitions, leakage audits, and hashed manifests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint src tests"
  },
  "dependencies": {
    "@futureclick/action-schema": "workspace:*",
    "@futureclick/action-understanding": "workspace:*",
    "@futureclick/privacy": "workspace:*",
    "@futureclick/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^20.11.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
