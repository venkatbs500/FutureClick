{
  "name": "@futureclick/browser-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension application for FutureClick synthetic action observation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint src tests",
    "serve:fixtures": "node scripts/serve-fixtures.mjs"
  },
  "dependencies": {
    "@futureclick/action-schema": "workspace:*",
    "@futureclick/browser-adapter": "workspace:*",
    "@futureclick/consequence-engine": "workspace:*",
    "@futureclick/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "esbuild": "^0.28.2",
    "happy-dom": "18.0.1",
    "puppeteer-core": "24.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
