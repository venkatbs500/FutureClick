# FutureClick Environment Configuration (Example)
# Production and research settings for local development.
# IMPORTANT: DO NOT COMMIT SECRETS OR REAL CREDENTIALS TO THIS FILE OR TO GIT.

# Environment Mode
NODE_ENV=development
ENVIRONMENT=local

# Logging & Telemetry (Telemetry is disabled by design in FC-001)
LOG_LEVEL=info
FUTURECLICK_TELEMETRY_ENABLED=false

# Service Ports (Placeholders for local services)
PREDICTION_ENGINE_PORT=8000
RESEARCH_DASHBOARD_PORT=3000
